{
  "name": "@sorting-table/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:dev": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths && concurrently -k -n tsc,alias,node -c blue,magenta,green \"npm:watch:tsc\" \"npm:watch:alias\" \"npm:watch:node\"",
    "watch:tsc": "tsc -p tsconfig.build.json --watch --pretty --preserveWatchOutput",
    "watch:alias": "tsc-alias -p tsconfig.build.json --watch --resolve-full-paths",
    "watch:node": "node --watch --watch-preserve-output dist/worker/src/main.js",
    "start:prod": "cross-env NODE_ENV=production node dist/worker/src/main.js",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "bullmq": "5.65.1",
    "lodash-es": "4.17.21",
    "ms": "2.1.3",
    "reflect-metadata": "0.2.2",
    "typescript-ioc": "3.2.2"
  },
  "devDependencies": {
    "@types/lodash-es": "4.17.12",
    "@types/ms": "2.1.0"
  }
}
